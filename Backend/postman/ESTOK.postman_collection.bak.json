{
  "info": {
    "name": "ESTOK API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Validação dos 20 endpoints do escopo (login, usuários, localizações e gestão de tarefas), mais diagnóstico. Execute a collection inteira no Collection Runner, na ordem; cada pasta cria e exclui seus próprios dados de teste. Não use dados reais."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email_auth",
      "value": ""
    },
    {
      "key": "auth_usuario_id",
      "value": "-1"
    },
    {
      "key": "email_teste",
      "value": ""
    },
    {
      "key": "usuario_id",
      "value": "-1"
    },
    {
      "key": "tarefa_vinculada_id",
      "value": "-1"
    },
    {
      "key": "localizacao_id",
      "value": "-1"
    },
    {
      "key": "email_responsavel",
      "value": ""
    },
    {
      "key": "responsavel_id",
      "value": "-1"
    },
    {
      "key": "titulo_teste",
      "value": ""
    },
    {
      "key": "tarefa_id",
      "value": "-1"
    }
  ],
  "item": [
    {
      "name": "Diagnóstico",
      "description": "Rotas auxiliares (não fazem parte dos 20 endpoints).",
      "item": [
        {
          "name": "01 — API disponível",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/saude"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Banco conectado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/saude/banco"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticação",
      "description": "Item 1. Cria um usuário exclusivo, testa o login e o exclui ao final.",
      "item": [
        {
          "name": "01 — Cadastrar usuário de teste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário de Teste\",\n  \"email\": \"{{email_auth}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"auth_usuario_id\", \"-1\");",
                  "pm.collectionVariables.set(\"email_auth\", \"estok.auth.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Resposta sem senha\", function () { pm.expect(pm.response.json()).not.to.have.property(\"senha\"); });",
                  "if(pm.response.code === 201) { pm.collectionVariables.set(\"auth_usuario_id\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Login válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_auth}}\",\n  \"senha\": \"TesteLocal123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Login não expõe senha\", function () { pm.expect(pm.response.json().usuario).not.to.have.property(\"senha\"); });",
                  "pm.test(\"Mensagem de sucesso\", function () { pm.expect(pm.response.json().mensagem).to.equal(\"Login realizado com sucesso\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — Rejeitar senha incorreta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_auth}}\",\n  \"senha\": \"incorreta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 — Rejeitar email não cadastrado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"naoexiste@example.com\",\n  \"senha\": \"TesteLocal123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 — Rejeitar corpo sem senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_auth}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 — Excluir usuário de teste",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/usuarios/{{auth_usuario_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
