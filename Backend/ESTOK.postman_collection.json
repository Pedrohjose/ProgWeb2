{
  "info": {
    "name": "ESTOK — Testes da API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Validação dos seis endpoints implementados (itens 1 e 8–12 da lista original), mais diagnóstico. Execute na ordem no Collection Runner. Um usuário exclusivo é criado e excluído ao final; não use dados reais. As demais 14 rotas do escopo ainda estão pendentes."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email_teste",
      "value": ""
    },
    {
      "key": "usuario_id",
      "value": "-1"
    }
  ],
  "item": [
    {
      "name": "01 — API disponível",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/saude"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Banco conectado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/saude/banco"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Cadastrar usuário",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuário de Teste\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"usuario_id\", \"-1\");",
              "pm.collectionVariables.set(\"email_teste\", \"estok.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Resposta sem senha\", function () { pm.expect(pm.response.json()).not.to.have.property(\"senha\"); });",
              "if(pm.response.code === 201) { pm.collectionVariables.set(\"usuario_id\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Rejeitar email duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuário de Teste\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Login válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login não expõe senha\", function () { pm.expect(pm.response.json().usuario).not.to.have.property(\"senha\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Rejeitar senha incorreta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"incorreta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Listar usuários",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios/all"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Usuário criado consta na lista\", function () { const users = pm.response.json(); pm.expect(users.some(u => u.id === Number(pm.collectionVariables.get(\"usuario_id\")))).to.equal(true); users.forEach(u => pm.expect(u).not.to.have.property(\"senha\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 — Consultar usuário por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios/{{usuario_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Resposta sem senha\", function () { pm.expect(pm.response.json()).not.to.have.property(\"senha\"); });",
              "pm.test(\"ID corresponde ao cadastro\", function () { pm.expect(pm.response.json().id).to.equal(Number(pm.collectionVariables.get(\"usuario_id\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 — Atualizar usuário",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios/{{usuario_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuário Atualizado\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Resposta sem senha\", function () { pm.expect(pm.response.json()).not.to.have.property(\"senha\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 — Conferir atualização salva",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios/{{usuario_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Nome atualizado persistiu\", function () { pm.expect(pm.response.json().nome).to.equal(\"Usuário Atualizado\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 — Rejeitar dados inválidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 — Consultar ID inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios/-1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 — Rejeitar ID não inteiro",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios/abc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 — Excluir usuário de teste",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/usuarios/{{usuario_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
              "pm.test(\"Exclusão sem conteúdo\", function () { pm.expect(pm.response.text()).to.equal(\"\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 — Confirmar exclusão",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/usuarios/{{usuario_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 — Repetir exclusão",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/usuarios/{{usuario_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
