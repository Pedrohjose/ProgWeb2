{
  "info": {
    "name": "ESTOK — João e Felipe — validação inicial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar na ordem em banco de desenvolvimento. Cria um usuario por execucao; nao cobre os 20 endpoints."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email_teste",
      "value": ""
    },
    {
      "key": "usuario_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 API ativa",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/saude"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Conexao MySQL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/saude/banco"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Cadastro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario de teste\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if(pm.response.code===201){pm.collectionVariables.set(\"usuario_id\",pm.response.json().id);} pm.test(\"Sem senha na resposta\",()=>pm.expect(pm.response.json()).not.to.have.property(\"senha\"));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"email_teste\", \"teste.\"+pm.variables.replaceIn(\"{{$guid}}\")+\"@example.com\");"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Email duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario de teste\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Login valido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Senha incorreta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"errada\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Atualizar usuario",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios/{{usuario_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario atualizado\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Usuario inexistente",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios/-1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario de teste\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"TesteLocal123!\",\n  \"perfil\": \"Funcionario\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Dados invalidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    }
  ]
}